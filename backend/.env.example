# backend/.env 로 복사 후 값 채우기 (cp .env.example .env). .env 는 Git에 올리지 않음.
# application.yml 의 spring.config.import 가 optional 로 .env / backend/.env 를 읽습니다.

# --- application.properties (로컬 앱 기동 시 보통 필수) ---
DB_URL=jdbc:postgresql://localhost:5432/LetsDiveIn
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password
SPRING_MAIL_USERNAME=your-smtp-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password-16chars-no-spaces
PAYMENTS_TOSS_SECRET_KEY=your-toss-secret-key

# --- application.yml / AI (없으면 일부 기능만 폴백) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000

APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CUSTOMER_FRONTEND_URL=http://localhost:3000
APP_ADMIN_FRONTEND_URL=http://localhost:3001
APP_FILE_MAX_IMAGE_DIMENSION=512
FILE_SIGNED_URL_SIGNING_SECRET=change-to-a-long-random-secret
FILE_SIGNED_URL_TTL_SECONDS=600
# 구 env (application.yml 에서 신규 키 없을 때만 폴백): AI_IMAGE_SIGNING_SECRET, AI_IMAGE_URL_TTL_SECONDS

STORAGE_PROVIDER=local
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PRESIGNED_TTL_SEC=600
